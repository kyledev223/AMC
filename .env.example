# Copy to .env and fill in. Never commit .env. Secrets below are server-only.

# ---------- Network ----------
# devnet | mainnet-beta | localnet. Defaults to devnet. Never set mainnet-beta without the launch checklist.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# RPC the browser uses (wallet balance reads). Leave blank for the public endpoint of the cluster.
NEXT_PUBLIC_RPC_URL=
# Helius key. Server-side RPC and DAS (getAssetsByGroup) for snapshots. Without it the server falls
# back to the public RPC and getProgramAccounts, which is fine on devnet and too slow for mainnet.
HELIUS_API_KEY=
# Public URL of the site, no trailing slash. Used in NFT metadata URIs and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Token and collection ----------
# The $AMC SPL mint. On devnet, create a test one with: npm run devnet:token
NEXT_PUBLIC_AMC_MINT=
# The Metaplex Core collection. Create it with: npm run devnet:collection
NEXT_PUBLIC_COLLECTION_ADDRESS=
# SECRET. Update authority of the collection. Base58 or a JSON byte array. Co-signs every mint
# and pays for the post-reveal rename, so keep a little SOL on it.
COLLECTION_AUTHORITY_SECRET=
# $AMC burned per mint, in whole tokens.
MINT_COST_AMC=100000

# ---------- Rewards ----------
# Public address of the pool wallet that receives creator fees.
POOL_WALLET=
# SECRET. The pool wallet's key. Signs payouts. Must match POOL_WALLET.
POOL_WALLET_SECRET=
# SOL (default) or AMC_TOKENIZED. AMC_TOKENIZED buys tokenized AMC stock and distributes it.
# DO NOT ENABLE without legal review: tokenized stocks are geo-restricted and distributing them
# may be a securities offering. See the README.
PAYOUT_ASSET=SOL
# Only for AMC_TOKENIZED: the tokenized stock mint (for example xStocks AMCx).
PAYOUT_TOKEN_MINT=
# Only for AMC_TOKENIZED on mainnet. Set to true only after a written legal review. Leave unset.
TOKENIZED_PAYOUTS_LEGAL_REVIEWED=
# Smallest payout, in whole units of the payout asset. Smaller amounts carry over to later epochs.
# Keep it above 0.00089 SOL: a transfer that leaves a new wallet below rent-exempt fails.
MIN_PAYOUT=0.001
# SOL kept in the pool wallet for transaction fees. Never distributed.
GAS_RESERVE_SOL=0.05

# ---------- Safety switches ----------
# false until launch. The countdown shows "Distributions start at launch" while false.
DISTRIBUTIONS_ENABLED=false
# true computes and records payouts without sending anything.
DRY_RUN=true

# ---------- Secrets for protected routes ----------
# SECRET. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>". Generate: openssl rand -hex 32
CRON_SECRET=
# SECRET. For POST /api/admin/pause with header "x-admin-secret". Generate: openssl rand -hex 32
ADMIN_SECRET=

# ---------- Database ----------
# Postgres (Neon or Supabase). Use the pooled connection string on Vercel.
DATABASE_URL=

